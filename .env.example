# Database connection string (PostgreSQL)
DATABASE_URL=

# Admin Dashboard Password (defaults to teslatrack-admin-2026)
ADMIN_PASSWORD=teslatrack-admin-2026

# CARTO Maps API & Basemap Endpoint (defaults to Carto basemaps / https://gcp-us-east1.api.carto.com)
CARTO_API_BASE_URL=https://gcp-us-east1.api.carto.com/
CARTO_ACCESS_TOKEN=

# Google Maps Platform API Key (for Google Maps live tracking)
VITE_GOOGLE_MAPS_API_KEY=

# Gemini API Key (for Maps Grounding with gemini-3.5-flash)
GEMINI_API_KEY=

# Gmail SMTP Configuration (for dispatching real-time shipment alert emails)
# Use your Gmail address and a 16-character Google App Password (from Google Account > Security > App Passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

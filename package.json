{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --config artifacts/tracker/vite.config.ts && esbuild server.ts --bundle --platform=node --format=cjs --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "typecheck": "tsc --build",
    "lint": "tsc --build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.5",
    "esbuild": "^0.25.0",
    "express": "^5.0.1",
    "prettier": "^3.5.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vite": "^7.3.2"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@types/nodemailer": "^8.0.2",
    "firebase": "^12.19.0",
    "nodemailer": "^10.0.10",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.2.0"
  }
}
